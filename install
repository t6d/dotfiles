#!/usr/bin/env bash
set -euo pipefail

has() { command -v "$1" >/dev/null 2>&1; }

install_homebrew() {
  if has brew; then return; fi
  echo "==> Installing Homebrew"
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

  if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi
}

install_fish_mac() {
  if has fish; then return; fi
  echo "==> Installing fish"
  brew install fish
}

install_fish_linux() {
  if has fish; then return; fi
  echo "==> Installing fish"
  sudo apt-get update
  sudo apt-get install -y fish
}

install_starship_linux() {
  if has starship; then return; fi
  echo "==> Installing starship"
  curl -sS https://starship.rs/install.sh | sh -s -- -y
}

install_delta_linux() {
  if has delta; then return; fi
  echo "==> Installing git-delta"
  local tmp
  tmp="$(mktemp -d)"
  ( cd "$tmp" \
    && wget -q https://github.com/dandavison/delta/releases/download/0.6.0/git-delta_0.6.0_amd64.deb \
    && sudo dpkg -i git-delta_0.6.0_amd64.deb )
  rm -rf "$tmp"
}

mkdir -p ~/.config

case "$(uname)" in
  Darwin)
    install_homebrew
    install_fish_mac
    ;;
  Linux)
    install_fish_linux
    install_starship_linux
    install_delta_linux
    ;;
  *)
    echo "Unsupported OS: $(uname)" >&2
    exit 1
    ;;
esac

yes | rake install:configuration_files
